#!/bin/bash
# Points ~/.local/bin/h0x-ade at this checkout's release build and adds the
# launcher entry with the HyperOx icon. Re-run after moving the checkout.
set -euo pipefail

[[ $(uname -s) == Linux ]] || { echo 'This installer is for Linux.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$HOME/.local/bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$PWD/target/release/h0x-ade" "$HOME/.local/bin/h0x-ade"
cp assets/icons/h0x-ade-icon.svg "$data/icons/hicolor/scalable/apps/h0x-ade.svg"
cat > "$data/applications/h0x-ade.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=HyperOx
Comment=Terminals and coding agents that keep running
Exec=$HOME/.local/bin/h0x-ade
Icon=h0x-ade
Terminal=false
Categories=Development;
StartupWMClass=h0x-ade
EOF
update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[[ -f $data/icons/hicolor/icon-theme.cache ]] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
echo "Installed h0x-ade. Quit and reopen HyperOx to use the new build."
